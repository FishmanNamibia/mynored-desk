  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model ExecutiveCommittee {
  id           String   @id
  name         String
  position     String
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model CoreValue {
  id           String   @id
  name         String
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model TrainingNeed {
  id                String   @id
  userId            String
  performancePeriodId String
  title             String
  description       String
  type              TrainingType
  urgency           TrainingUrgency
  priority          Int      @default(1)
  preferredTimeline String?
  estimatedCost     Decimal?
  provider          String?
  status            TrainingNeedStatus @default(PENDING)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  user               User @relation("TrainingNeed_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  performancePeriod  PerformancePeriod @relation("TrainingNeed_performancePeriodIdToPerformancePeriod", fields: [performancePeriodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([performancePeriodId])
  @@index([type])
  @@index([urgency])
  @@index([status])
}
