generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ADConfig {
  id           String    @id
  domain       String    @unique
  url          String
  bindDN       String
  bindPassword String
  groupRoleMap Json
  enabled      Boolean   @default(true)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model AdhocTask {
  id                                String    @id
  title                             String
  description                       String?
  priority                          String    @default("MEDIUM")
  dueDate                           DateTime?
  assignedToId                      String
  createdById                       String
  status                            String    @default("NOT_STARTED")
  percentComplete                   Int       @default(0)
  evidenceUrl                       String?
  evidenceNotes                     String?
  rating                            Int?
  approvalStatus                    String?   @default("PENDING")
  approvedById                      String?
  approvedAt                        DateTime?
  progressNotes                     String?
  completedAt                       DateTime?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime
  approvedByUser User?     @relation("AdhocTask_approvedByIdToUser", fields: [approvedById], references: [id])
  assignedTo      User      @relation("AdhocTask_assignedToIdToUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("AdhocTask_createdByIdToUser", fields: [createdById], references: [id])

  @@index([approvedById])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
}

model AuditTask {
  id                                String    @id
  title                             String
  description                       String?
  priority                          String    @default("MEDIUM")
  dueDate                           DateTime?
  assignedToId                      String
  createdById                       String
  status                            String    @default("NOT_STARTED")
  percentComplete                   Int       @default(0)
  evidenceUrl                       String?
  evidenceNotes                     String?
  rating                            Int?
  approvalStatus                    String?   @default("PENDING")
  approvedById                      String?
  approvedAt                        DateTime?
  progressNotes                     String?
  completedAt                       DateTime?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime
  actionPlan                        String?
  businessObjective                 String?
  condition                         String?
  controlAssessment                 String?   @default("PENDING")
  criteria                          String?
  estimatedCompletionDate           DateTime?
  impact                            String?
  managementActionPlan              String?
  personResponsible                 String?
  recommendation                    String?
  riskExposure                      String?
  riskRanking                       String?   @default("MEDIUM")
  rootCause                         String?
  approvedByUser User?     @relation("AuditTask_approvedByIdToUser", fields: [approvedById], references: [id])
  assignedTo      User      @relation("AuditTask_assignedToIdToUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("AuditTask_createdByIdToUser", fields: [createdById], references: [id])

  @@index([approvedById])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
}

model Boardroom {
  id               String             @id
  name             String
  location         String?
  capacity         Int?
  amenities        String?
  isAvailable      Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  BoardroomRequest BoardroomRequest[]
}

model BoardroomRequest {
  id          String    @id
  requestId   String
  boardroomId String
  startTime   DateTime
  endTime     DateTime
  purpose     String
  attendees   Int
  Boardroom   Boardroom @relation(fields: [boardroomId], references: [id], onUpdate: NoAction)
  Request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requestId, boardroomId])
}

model DashboardEvent {
  id          String   @id
  title       String
  date        String
  time        String
  location    String
  description String?
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([isActive])
}

model DashboardNews {
  id          String   @id
  title       String
  excerpt     String
  category    String
  date        String
  icon        String?  @default("TrendingUp")
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([createdById])
  @@index([isActive])
}

model DashboardNotice {
  id          String   @id
  title       String
  message     String
  type        String   @default("info")
  department  String?
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([isActive])
}

model Department {
  id               String        @id
  code             String        @unique
  name             String
  parentId         String?
  managerId        String?
  managerName      String?
  managerEmail     String?
  adSyncedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  parent           Department?   @relation("DepartmentToDepartment", fields: [parentId], references: [id])
  children         Department[]  @relation("DepartmentToDepartment")
  ITEquipment      ITEquipment[]
  License          License[]
  Project          Project[]
  users            User[]
  Vacancy          Vacancy[]
}

model Goal {
  id              String      @id
  goalNumber      String
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  performanceYear String      @default("2024/25")
  bscPerspective  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  objectives      Objective[]

  @@index([endDate])
  @@index([goalNumber])
  @@index([performanceYear])
  @@index([startDate])
}

model ITEquipment {
  id                 String               @id
  name               String
  category           String
  brand              String?
  model              String?
  serialNumber       String?              @unique
  assetTag           String?              @unique
  quantity           Int                  @default(0)
  givenOut           Int                  @default(0)
  condition          EquipmentCondition   @default(GOOD)
  departmentId       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  Department         Department?          @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  ITEquipmentRequest ITEquipmentRequest[]

  @@index([category])
  @@index([condition])
}

model ITEquipmentRequest {
  id                String       @id
  requestId         String
  equipmentId       String?
  quantityRequested Int
  quantityApproved  Int?
  purpose           String?
  returnDate        DateTime?
  ITEquipment       ITEquipment? @relation(fields: [equipmentId], references: [id], onUpdate: NoAction)
  Request           Request      @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requestId, equipmentId])
}

model Initiative {
  id                      String                 @id
  number                  String?
  title                   String
  description             String?
  measure                 String?
  action                  String?
  reportingPeriods        String[]
  quarterDates            Json?
  target                  String?
  dueDate                 DateTime?
  primaryResponsibility   String?
  secondaryResponsibility String?
  status                  String?                @default("NOT_STARTED")
  percentComplete         Int?                   @default(0)
  progressNotes           String?
  evidenceUrl             String?
  evidenceNotes           String?
  rating                  Int?
  objectiveId             String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime
  objective               Objective              @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  performanceAgreements   PerformanceAgreement[]
  targets                 Target[]

  @@index([objectiveId])
  @@index([primaryResponsibility])
  @@index([secondaryResponsibility])
}

model LeaveRequest {
  id        String      @id
  userId    String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus
  User      User        @relation(fields: [userId], references: [id])
}

model License {
  id               String           @id
  licenseKey       String           @unique
  licenseType      LicenseType
  status           LicenseStatus    @default(ACTIVE)
  vendorId         String
  systemId         String
  departmentId     String?
  productName      String
  version          String?
  edition          String?
  userCount        Int?
  description      String?
  purchaseDate     DateTime
  startDate        DateTime
  expiryDate       DateTime
  lastRenewedDate  DateTime?
  renewalFrequency RenewalFrequency
  autoRenew        Boolean          @default(false)
  renewalCost      Decimal?         @db.Decimal(10, 2)
  currency         String           @default("NAD")
  alertThreshold   Int              @default(30)
  supportContact   String?
  supportEmail     String?
  supportPhone     String?
  documentationUrl String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  Department       Department?      @relation(fields: [departmentId], references: [id])
  System           System           @relation(fields: [systemId], references: [id])
  Vendor           Vendor           @relation(fields: [vendorId], references: [id])
  LicenseAlert     LicenseAlert[]
  LicenseRenewal   LicenseRenewal[]

  @@index([expiryDate])
  @@index([licenseType])
  @@index([status])
}

model LicenseAlert {
  id               String        @id
  licenseId        String
  alertType        AlertType
  severity         AlertSeverity
  message          String
  daysUntilExpiry  Int
  notificationSent Boolean       @default(false)
  notifiedAt       DateTime?
  taskCreated      Boolean       @default(false)
  taskId           String?
  acknowledged     Boolean       @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  createdAt        DateTime      @default(now())
  License          License       @relation(fields: [licenseId], references: [id])
  Task             Task?         @relation(fields: [taskId], references: [id])

  @@index([acknowledged])
  @@index([licenseId])
  @@index([notificationSent])
}

model LicenseRenewal {
  id                 String            @id
  licenseId          String
  renewalDate        DateTime
  previousExpiryDate DateTime
  newExpiryDate      DateTime
  cost               Decimal?          @db.Decimal(10, 2)
  currency           String            @default("NAD")
  status             RenewalStatus     @default(PENDING)
  workflowInstanceId String?
  initiatedBy        String
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  License            License           @relation(fields: [licenseId], references: [id])
  WorkflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  @@index([licenseId])
  @@index([status])
}

model Memo {
  id                     String       @id
  createdById            String
  status                 MemoStatus   @default(DRAFT)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  amountSpent            Decimal?     @db.Decimal(15, 2)
  attachments            Json?
  availableFunds         Decimal?     @db.Decimal(15, 2)
  budgetApproved         String?
  budgetVote             String?
  budgetedAmount         Decimal?     @db.Decimal(15, 2)
  executiveName          String?
  executiveSignatureDate DateTime?
  executiveSignaturePath String?
  financialComments      String?
  financialVerification  String?
  memoDate               DateTime     @default(now())
  memoFrom               String
  memoFromTitle          String?
  memoThrough            Json?
  memoTo                 String
  memoToTitle            String?
  priority               MemoPriority @default(NORMAL)
  procurementActivity    String?
  purpose                String
  recommendation         String
  subject                String
  title                  String
  content                String
  createdBy              User         @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([memoDate])
  @@index([status])
}

model News {
  id        String   @id
  title     String
  content   String
  authorId  String
  imageUrl  String?
  excerpt   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Objective {
  id          String       @id
  title       String
  description String?
  goalId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  initiatives Initiative[]
  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model PeerRating360 {
  id          String    @id
  rating360Id String
  raterId     String
  rating      Float?
  comments    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  rater       User      @relation(fields: [raterId], references: [id], onDelete: Cascade)
  rating360   Rating360 @relation(fields: [rating360Id], references: [id], onDelete: Cascade)

  @@unique([rating360Id, raterId])
  @@index([raterId])
}

model PerformanceAgreement {
  id                                           String             @id
  title                                        String
  description                                  String?
  kpi                                          String?
  target                                       String?
  customAction                                 String?
  weight                                       Int?
  originalWeight                               Int?
  dueDate                                      DateTime
  userId                                       String
  status                                       String             @default("NOT_STARTED")
  percentComplete                              Int                @default(0)
  evidenceUrl                                  String?
  evidenceNotes                                String?
  rating                                       Int?
  supervisorId                                 String?
  approvalStatus                               String?
  approvedAt                                   DateTime?
  isLocked                                     Boolean            @default(false)
  confirmedAt                                  DateTime?
  isDiscontinued                               Boolean            @default(false)
  discontinuedAt                               DateTime?
  progressNotes                                String?
  completedAt                                  DateTime?
  initiativeId                                 String?
  performancePeriodId                          String?
  isAdhocContainer                             Boolean            @default(false)
  isSystemGenerated                            Boolean            @default(false)
  createdAt                                    DateTime           @default(now())
  updatedAt                                    DateTime
  initiative                                   Initiative?        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  performancePeriod                             PerformancePeriod? @relation(fields: [performancePeriodId], references: [id])
  supervisor                                   User?              @relation("PerformanceAgreement_supervisorIdToUser", fields: [supervisorId], references: [id])
  user                                         User               @relation("PerformanceAgreement_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([initiativeId])
  @@index([isAdhocContainer])
  @@index([performancePeriodId])
  @@index([status])
  @@index([supervisorId])
  @@index([userId])
  @@index([userId, initiativeId])
}

model PerformancePeriod {
  id                   String                 @id
  name                 String
  submissionDeadline   DateTime
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean                @default(true)
  adhocWeight          Int                    @default(10)
  projectsWeight       Int                    @default(10)
  riskManagementWeight Int                    @default(10)
  rating360Weight      Int                    @default(10)
  createdById          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  performanceAgreements PerformanceAgreement[]
  createdBy              User                   @relation(fields: [createdById], references: [id])
  userTaskWeights        UserTaskWeight[]
  trainingNeeds          TrainingNeed[]         @relation("TrainingNeed_performancePeriodIdToPerformancePeriod")

  @@index([createdById])
  @@index([submissionDeadline])
}

model PerformanceReview {
  id                                      String   @id
  userId                                  String
  reviewerId                              String
  reviewDate                              DateTime
  feedback                                String
  rating                                  Int
  reviewer User     @relation("PerformanceReview_reviewerIdToUser", fields: [reviewerId], references: [id])
  user     User     @relation("PerformanceReview_userIdToUser", fields: [userId], references: [id])
}

model Permission {
  id             String           @id
  name           String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RolePermission RolePermission[]
}

model PmsAuditLog {
  id         String      @id
  actorId    String?
  entityType String
  entityId   String
  action     AuditAction
  beforeData Json?
  afterData  Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model PmsNotification {
  id                                    String             @id
  type                                  NotificationType
  status                                NotificationStatus @default(PENDING)
  senderId                              String?
  receiverId                            String
  entityType                            String?
  entityId                              String?
  message                               String
  metadata                              Json?
  createdAt                             DateTime           @default(now())
  updatedAt                             DateTime
  receiver User               @relation("PmsNotification_receiverIdToUser", fields: [receiverId], references: [id])
  sender   User?              @relation("PmsNotification_senderIdToUser", fields: [senderId], references: [id])

  @@index([createdAt])
  @@index([receiverId, status])
  @@index([senderId])
}

model PolicyDocument {
  id            String   @id
  title         String
  description   String
  category      String
  version       String
  effectiveDate String
  fileSize      String
  pdfPath       String
  createdById   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([createdById])
  @@index([isActive])
}

model Project {
  id                             String              @id
  title                          String
  description                    String?
  status                         String              @default("PLANNING")
  priority                       String              @default("MEDIUM")
  percentComplete                Int                 @default(0)
  plannedStartDate               DateTime?
  plannedEndDate                 DateTime?
  actualStartDate                DateTime?
  actualEndDate                  DateTime?
  budget                         Float?
  currency                       String              @default("NAD")
  ownerId                        String
  createdById                    String
  departmentId                   String?
  divisionId                     String?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @default(now())
  createdByUser                  User                @relation("Project_createdByIdToUser", fields: [createdById], references: [id], onUpdate: NoAction)
  department                     Department?         @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  owner                          User                @relation("Project_ownerIdToUser", fields: [ownerId], references: [id], onUpdate: NoAction)
  documents                      ProjectDocument[]
  issues                         ProjectIssue[]
  risks                          ProjectRisk[]
  tasks                          ProjectTask[]
  teamMembers                    ProjectTeamMember[]

  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
}

model ProjectDocument {
  id        String   @id
  projectId String
  title     String
  url       String?
  fileType  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
}

model ProjectIssue {
  id          String   @id
  projectId   String
  title       String
  description String?
  severity    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
}

model ProjectRisk {
  id          String   @id
  projectId   String
  title       String
  description String?
  severity    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
}

model ProjectTask {
  id               String    @id
  projectId        String
  title            String
  description      String?
  status           String    @default("NOT_STARTED")
  priority         String    @default("MEDIUM")
  percentComplete  Int       @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  estimatedHours   Float?
  assignedToId     String?
  phaseId          String?
  phaseName        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  assignedTo       User?     @relation(fields: [assignedToId], references: [id], onUpdate: NoAction)
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignedToId])
  @@index([projectId])
}

model ProjectTeamMember {
  id        String   @id
  projectId String
  userId    String
  role      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([userId])
}

model QuestionnaireOpenEnded {
  id                             String                           @id
  sectionId                      String
  question                       String
  order                          Int
  isRequired                     Boolean                          @default(false)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @default(now())
  QuestionnaireSection           QuestionnaireSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  QuestionnaireOpenEndedResponse QuestionnaireOpenEndedResponse[]

  @@index([order])
  @@index([sectionId])
}

model QuestionnaireOpenEndedResponse {
  id                     String                 @id
  questionId             String
  rating360Id            String
  raterId                String
  raterType              String
  response               String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now())
  QuestionnaireOpenEnded QuestionnaireOpenEnded @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, rating360Id, raterId, raterType], map: "QuestionnaireOpenEndedResponse_questionId_rating360Id_raterId_r")
  @@index([raterId])
  @@index([rating360Id])
}

model QuestionnaireQuestion {
  id                      String                  @id
  subsectionId            String
  statement               String
  order                   Int
  requiresComment         Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  QuestionnaireSubsection QuestionnaireSubsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  QuestionnaireResponse   QuestionnaireResponse[]

  @@index([order])
  @@index([subsectionId])
}

model QuestionnaireResponse {
  id                    String                @id
  questionId            String
  rating360Id           String
  raterId               String
  raterType             String
  rating                Float
  comment               String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  QuestionnaireQuestion QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, rating360Id, raterId, raterType], map: "QuestionnaireResponse_questionId_rating360Id_raterId_raterType_")
  @@index([raterId])
  @@index([rating360Id])
}

model QuestionnaireSection {
  id                      String                    @id
  templateId              String
  title                   String
  description             String?
  order                   Int
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  QuestionnaireOpenEnded  QuestionnaireOpenEnded[]
  QuestionnaireTemplate   QuestionnaireTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  QuestionnaireSubsection QuestionnaireSubsection[]

  @@index([order])
  @@index([templateId])
}

model QuestionnaireSubsection {
  id                    String                  @id
  sectionId             String
  title                 String
  description           String?
  institutionalValue    String?
  order                 Int
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  QuestionnaireQuestion QuestionnaireQuestion[]
  QuestionnaireSection  QuestionnaireSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([sectionId])
}

model QuestionnaireTemplate {
  id                   String                 @id
  name                 String
  description          String?
  instructions         String?
  ratingScaleDesc      String?
  isActive             Boolean                @default(true)
  isDefault            Boolean                @default(false)
  createdBy            String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  QuestionnaireSection QuestionnaireSection[]

  @@index([isActive])
  @@index([isDefault])
}

model Rating360 {
  id                                String                 @id
  cycleId                           String
  userId                            String
  selfRating                        Float?
  selfComments                      String?
  selfCompletedAt                   DateTime?
  supervisorId                      String?
  supervisorRating                  Float?
  supervisorComments                String?
  supervisorCompletedAt             DateTime?
  averageRating                     Float?
  status                            String                 @default("PENDING")
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @default(now())
  peerRatings                       PeerRating360[]
  cycle                              Rating360Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  supervisor                         User?                  @relation("Rating360_supervisorIdToUser", fields: [supervisorId], references: [id])
  user                               User                   @relation("Rating360_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  subordinateRatings                 SubordinateRating360[]

  @@unique([cycleId, userId])
  @@index([status])
  @@index([supervisorId])
  @@index([userId])
}

model Rating360Answer {
  id                String            @id
  questionId        String
  rating360Id       String
  raterId           String
  raterType         String
  rating            Float
  comments          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now())
  question Rating360Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, rating360Id, raterId, raterType])
  @@index([raterId])
  @@index([rating360Id])
}

model Rating360Category {
